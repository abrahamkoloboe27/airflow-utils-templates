# Airflow user ID (run `id -u` on Linux to get your UID)
AIRFLOW_UID=50000

# Docker image name (leave empty to build from local Dockerfile)
# AIRFLOW_IMAGE_NAME=extend_airflow:3

# Base directory for volume mounts (default: current directory)
# AIRFLOW_PROJ_DIR=.

# Admin account credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Fernet key for encrypting connections (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW__CORE__FERNET_KEY=Gp6wDeVXdHtILQx2a85JFpfiKWspnGSt99dIWLeXcWA=

# SMTP settings
AIRFLOW__SMTP__SMTP_HOST=
AIRFLOW__SMTP__SMTP_PORT=
AIRFLOW__SMTP__SMTP_USER=
AIRFLOW__SMTP__SMTP_PASSWORD=
AIRFLOW__SMTP__SMTP_STARTTLS=
AIRFLOW__SMTP__SMTP_SENDER_NAME=
AIRFLOW__SMTP__SMTP_MAIL_FROM=
AIRFLOW__SMTP__SMTP_SSL=
